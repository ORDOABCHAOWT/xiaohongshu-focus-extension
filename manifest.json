{
  "manifest_version": 3,
  "name": "小红书专注搜索页",
  "version": "1.0.0",
  "description": "访问小红书 explore 时隐藏信息流，只显示搜索框和个人主页头像。",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/xhs-icon.png",
        "assets/bottom-bg-openai-b.png"
      ],
      "matches": [
        "https://www.xiaohongshu.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "src/focus-core.js",
        "src/content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
